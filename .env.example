# ─── API (apps/api) ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (customer/kitchen/waiter/admin).
# CLIENT_ORIGIN (singular) is also accepted for backward compat with a single origin.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Logging — trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Body parser max size (any value ms/bytes parses; see express docs)
BODY_LIMIT=100kb

# Global rate limit (per IP) — applied to every route
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Graceful shutdown — milliseconds to drain before force-exit
SHUTDOWN_TIMEOUT_MS=10000

# Postgres — host port 5433 (55432 hit a Windows permission issue; 5432 may collide with a native install)
DATABASE_URL=postgres://orvexa:orvexa@localhost:5433/orvexa

# Redis (sessions / pub-sub — used from Phase 8 onward)
REDIS_URL=redis://localhost:6379

# Auth — required in production; dev falls back to change-me-dev-only
JWT_SECRET=change-me-dev-only
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# JWT_EXPIRES_IN is honored as a fallback for JWT_REFRESH_EXPIRES_IN (legacy)

# Customer QR sessions — separate secret so a staff JWT leak can't forge a session
SESSION_JWT_SECRET=change-me-dev-only
SESSION_JWT_EXPIRES_IN=12h
# Renew window: if a session has less than this time left, renewal extends expiry
SESSION_RENEW_THRESHOLD=1h

# Customer app URL — embedded in the QR code as `${CUSTOMER_APP_URL}/t/<token>`
CUSTOMER_APP_URL=http://localhost:5173

# Image uploads — local dev stores under `apps/api/uploads/`, served from PUBLIC_BASE_URL
UPLOADS_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000
UPLOADS_MAX_BYTES=5242880

# Demo mode — surfaces in /version. Pair with `npm run db:seed` and a daily reset cron
# to provide a sandbox environment for evaluators. See docs/DEMO_MODE.md.
DEMO_MODE=false

# ─── Frontends (apps/customer, kitchen, waiter, admin) ───────────
# Vite exposes any VITE_-prefixed var to frontend code via import.meta.env.
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# ─── Production env file ──────────────────────────────────────────
# Copy to .env.production and edit. ALL secrets must be replaced.
# Used by:  docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ── Domain & URLs (search/replace tableflow.tn for your domain) ────
# Customer-facing apex (kept short for printable QR codes).
CUSTOMER_APP_URL=https://tableflow.tn
PUBLIC_BASE_URL=https://api.tableflow.tn

# Origins allowed to call the API. Must include every frontend host.
CLIENT_ORIGINS=https://tableflow.tn,https://www.tableflow.tn,https://kitchen.tableflow.tn,https://waiter.tableflow.tn,https://admin.tableflow.tn

# Baked into frontend bundles at build time (Vite inlines VITE_*).
# Each frontend image picks these up via build args in docker-compose.prod.yml.
VITE_API_URL=https://api.tableflow.tn
VITE_SOCKET_URL=https://api.tableflow.tn

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_DB=orvexa
POSTGRES_USER=orvexa
# REQUIRED: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=replace-me-with-a-real-password

# Used by the api service. Hostname `db` is the compose service name.
DATABASE_URL=postgres://orvexa:replace-me-with-a-real-password@db:5432/orvexa

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth secrets ──────────────────────────────────────────────────
# REQUIRED: generate each with `openssl rand -base64 48`
JWT_SECRET=replace-me-jwt-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

SESSION_JWT_SECRET=replace-me-session-secret
SESSION_JWT_EXPIRES_IN=12h
SESSION_RENEW_THRESHOLD=1h

# ── API tuning ────────────────────────────────────────────────────
LOG_LEVEL=info
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SHUTDOWN_TIMEOUT_MS=10000
UPLOADS_MAX_BYTES=5242880

# ── Let's Encrypt ─────────────────────────────────────────────────
# Read by deploy/scripts/init-certs.sh. Not consumed by compose itself.
# DOMAINS is space-separated. LE_EMAIL receives Let's Encrypt expiration warnings.
# DOMAINS=tableflow.tn www.tableflow.tn kitchen.tableflow.tn waiter.tableflow.tn admin.tableflow.tn api.tableflow.tn
# LE_EMAIL=ops@example.com
